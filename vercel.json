{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/signup", "destination": "/download", "permanent": true },
    { "source": "/early-access", "destination": "/download", "permanent": true },
    { "source": "/features", "destination": "/", "permanent": true }
  ],
  "rewrites": [
    {
      "source": "/s/:id([A-Za-z0-9_-]+)",
      "destination": "https://api.smartplaycaddie.com/s/:id"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    }
  ]
}
